# Réglages de l'envoi des formulaires par e-mail (POST /api/contact).
# Copier ce fichier en « .env » pour un essai local, ou renseigner ces variables dans les
# réglages de l'hébergeur (Vercel : Project Settings > Environment Variables).
# Ne JAMAIS enregistrer de vraies valeurs dans le dépôt.

# Serveur SMTP Infomaniak. Port 587 = STARTTLS (recommandé), port 465 = SSL/TLS.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587

# Boîte qui envoie les e-mails (adresse complète) et son mot de passe.
SMTP_USER=contact@wassia-holding.com
SMTP_PASS=

# Adresse qui reçoit les demandes (contact@wassia-holding.com si laissé vide).
CONTACT_TO=contact@wassia-holding.com

# Clé SECRÈTE Cloudflare Turnstile (anti-robots). Sans elle, la vérification est ignorée.
# La clé publique du widget se règle dans src/app/content/site.ts (TURNSTILE_SITE_KEY).
TURNSTILE_SECRET=
